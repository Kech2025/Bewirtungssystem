<ContentPage
    x:Class="Bestellung.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Bestellung">
    <VerticalStackLayout
        Padding="24"
        Spacing="8"
        VerticalOptions="Center">
        <Label Text="Preisliste (Termin)" />
        <Picker
            x:Name="TerminPicker"
            Title="Termin wählen"
            ItemDisplayBinding="{Binding Anzeige}"
            SelectedIndexChanged="OnTerminSelectionChanged" />
        <Label Text="Name" />
        <Picker
            x:Name="BenutzerPicker"
            Title="Benutzer wählen"
            ItemDisplayBinding="{Binding Name}" />
        <Label Text="Modus" />
        <Picker
            x:Name="ModusPicker"
            Title="Modus wählen">
            <Picker.Items>
                <x:String>Bestellung</x:String>
                <x:String>Auslieferung Getränke</x:String>
                <x:String>Auslieferung Speisen</x:String>
            </Picker.Items>
        </Picker>
        <Button
            Margin="0,16,0,0"
            Clicked="OnAnmeldenClicked"
            Text="Anmelden" />
        <Button
            Margin="0,8,0,0"
            Clicked="OnAbmeldenClicked"
            Text="Abmelden" />
    </VerticalStackLayout>
</ContentPage>