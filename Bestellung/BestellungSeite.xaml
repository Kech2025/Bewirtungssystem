<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Bestellung.BestellungSeite"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Bestellung">
    <Shell.TitleView>
        <Grid Padding="0,0,10,0" ColumnDefinitions="Auto,Auto,Auto,*">
            <Button
                x:Name="BestellenButton"
                Grid.Column="0"
                Padding="12,0"
                Clicked="OnBestellenClicked"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="36"
                HorizontalOptions="Start"
                IsEnabled="False"
                Text="Bestellen"
                VerticalOptions="Center" />
            <Button
                x:Name="RechnungButton"
                Grid.Column="1"
                Margin="8,0,0,0"
                Padding="12,0"
                Clicked="OnRechnungClicked"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="36"
                HorizontalOptions="Start"
                IsEnabled="False"
                Text="Rechnung"
                VerticalOptions="Center" />
            <Button
                x:Name="RechnungAufteilenButton"
                Grid.Column="2"
                Margin="8,0,0,0"
                Padding="12,0"
                Clicked="OnRechnungAufteilenClicked"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="36"
                HorizontalOptions="Start"
                IsVisible="False"
                Text="Rechnung aufteilen"
                VerticalOptions="Center" />
            <Label
                x:Name="BenutzerLabel"
                Grid.Column="3"
                FontSize="12"
                HorizontalTextAlignment="End"
                VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>
    <Grid Padding="20,6,20,20" RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <HorizontalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Start">
            <Label Text="Tisch:" VerticalOptions="Center" />
            <Picker
                x:Name="TischPicker"
                Title="Tischnummer wählen"
                ItemDisplayBinding="{Binding Anzeige}"
                SelectedIndexChanged="OnTischChanged"
                WidthRequest="150" />
            <Label
                x:Name="GesamtTitelLabel"
                Margin="20,0,0,0"
                Text="Gesamt:"
                VerticalOptions="Center" />
            <Label
                x:Name="GesamtpreisLabel"
                FontAttributes="Bold"
                HorizontalTextAlignment="End"
                Text="0,00 €"
                VerticalOptions="Center"
                WidthRequest="90" />
        </HorizontalStackLayout>

        <Label
            x:Name="PreislisteTitel"
            Grid.Row="1"
            FontAttributes="Bold"
            IsVisible="False"
            Text="Preisliste" />

        <CollectionView
            x:Name="PreislisteView"
            Grid.Row="2"
            IsVisible="False">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Padding="{Binding Einzug}"
                        ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                        ColumnSpacing="4"
                        RowDefinitions="Auto,Auto">
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="{Binding AktionsButtonFarbe}"
                            Clicked="OnAktionButtonClicked"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding ZeigeAktionsButton}"
                            Text="{Binding AktionsZeichen}"
                            VerticalOptions="Center"
                            WidthRequest="36" />
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                LineBreakMode="WordWrap"
                                Text="{Binding Produkt}"
                                TextColor="{Binding ProduktFarbe}" />
                            <Label
                                FontSize="12"
                                Text="{Binding PreisText}"
                                TextColor="Gray" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Padding="0"
                            Clicked="OnMengeMinus"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding ZeigeMengenButtons}"
                            Text="−"
                            VerticalOptions="Center"
                            WidthRequest="36" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="3"
                            HorizontalTextAlignment="Center"
                            Text="{Binding AnzeigeMenge}"
                            VerticalOptions="Center"
                            WidthRequest="28" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="4"
                            Padding="0"
                            Clicked="OnMengePlus"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding ZeigeMengenButtons}"
                            Text="+"
                            VerticalOptions="Center"
                            WidthRequest="36" />
                        <Entry
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="4"
                            IsVisible="{Binding ZeigeBesonderheit}"
                            Placeholder="Besonderheit"
                            Text="{Binding Besonderheit}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid
            x:Name="RechnungBereich"
            Grid.Row="2"
            IsVisible="False"
            RowDefinitions="Auto,*,Auto,Auto">
            <Label
                Grid.Row="0"
                FontAttributes="Bold"
                Text="Rechnung" />
            <CollectionView
                x:Name="RechnungView"
                Grid.Row="1"
                Margin="0,6,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    Text="{Binding AnzeigeText}"
                                    VerticalOptions="Center" />
                                <HorizontalStackLayout
                                    IsVisible="{Binding ZeigeGeliefert}"
                                    Spacing="6">
                                    <CheckBox IsChecked="{Binding Geliefert}" VerticalOptions="Center" />
                                    <Label
                                        Text="geliefert"
                                        FontSize="12"
                                        TextColor="Gray"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                HorizontalTextAlignment="End"
                                Text="{Binding SummeText}"
                                TextColor="Gray"
                                VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid
                Grid.Row="2"
                Margin="0,8,0,0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    Text="Gesamt:"
                    VerticalOptions="Center" />
                <Label
                    x:Name="RechnungSummeLabel"
                    Grid.Column="1"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="End"
                    Text="0,00 €"
                    VerticalOptions="Center" />
            </Grid>
            <HorizontalStackLayout
                Grid.Row="3"
                Margin="0,8,0,0"
                Spacing="10">
                <Label Text="Betrag:" VerticalOptions="Center" />
                <Entry
                    x:Name="BetragEntry"
                    Keyboard="Numeric"
                    Placeholder="0,00"
                    VerticalOptions="Center"
                    WidthRequest="120" />
                <Button
                    x:Name="BezahlenButton"
                    Padding="12,0"
                    Clicked="OnBezahlenClicked"
                    FontAttributes="Bold"
                    HeightRequest="36"
                    Text="Bezahlen"
                    VerticalOptions="Center" />
                <Button
                    x:Name="AbbrechenButton"
                    Padding="12,0"
                    Clicked="OnAbbrechenClicked"
                    HeightRequest="36"
                    Text="Abbrechen"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <Grid
            x:Name="TeilRechnungBereich"
            Grid.Row="2"
            IsVisible="False"
            RowDefinitions="Auto,*,Auto,Auto">
            <Label
                Grid.Row="0"
                FontAttributes="Bold"
                Text="Rechnung aufteilen" />
            <CollectionView
                x:Name="TeilRechnungView"
                Grid.Row="1"
                Margin="0,6,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="0,6"
                            ColumnDefinitions="*,Auto,Auto,Auto"
                            ColumnSpacing="4">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    Text="{Binding Produkt}" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding MengenText}"
                                    TextColor="Gray" />
                                <HorizontalStackLayout
                                    IsVisible="{Binding ZeigeGeliefert}"
                                    Spacing="6">
                                    <CheckBox IsChecked="{Binding Geliefert}" VerticalOptions="Center" />
                                    <Label
                                        Text="geliefert"
                                        FontSize="12"
                                        TextColor="Gray"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Padding="0"
                                Clicked="OnTeilMengeMinus"
                                CommandParameter="{Binding .}"
                                Text="−"
                                VerticalOptions="Center"
                                WidthRequest="36" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="Center"
                                Text="{Binding TeilMengeText}"
                                VerticalOptions="Center"
                                WidthRequest="36" />
                            <Button
                                Grid.Column="3"
                                Padding="0"
                                Clicked="OnTeilMengePlus"
                                CommandParameter="{Binding .}"
                                Text="+"
                                VerticalOptions="Center"
                                WidthRequest="36" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid
                Grid.Row="2"
                Margin="0,8,0,0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    Text="Teilbetrag:"
                    VerticalOptions="Center" />
                <Entry
                    x:Name="TeilRechnungSummeEntry"
                    Grid.Column="1"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="End"
                    Keyboard="Numeric"
                    Placeholder="0,00"
                    TextChanged="OnTeilbetragTextChanged"
                    VerticalOptions="Center"
                    WidthRequest="120" />
            </Grid>
            <HorizontalStackLayout
                Grid.Row="3"
                Margin="0,8,0,0"
                Spacing="10">
                <Button
                    x:Name="TeilBezahlenButton"
                    Padding="12,0"
                    Clicked="OnTeilBezahlenClicked"
                    FontAttributes="Bold"
                    HeightRequest="36"
                    Text="Teil bezahlen"
                    VerticalOptions="Center" />
                <Button
                    x:Name="TeilAbbrechenButton"
                    Padding="12,0"
                    Clicked="OnTeilAbbrechenClicked"
                    HeightRequest="36"
                    Text="Abbrechen"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>