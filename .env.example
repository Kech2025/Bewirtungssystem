# Vorlage für Umgebungsvariablen. Kopiere diese Datei zu ".env" und passe die Werte an.
# docker compose liest ".env" im selben Verzeichnis automatisch ein.
#
# api/web verbinden sich mit der BEREITS laufenden Datenbank (Container "postgres_db").
# Trage hier die Zugangsdaten DEINER bestehenden Datenbank ein.
# Host bleibt "host.docker.internal" (= der Host, auf dem postgres_db Port 5432 veröffentlicht).

BEWIRTUNG_DB_CONNECTION=Host=host.docker.internal;Port=5432;Database=bewirtung;Username=postgres;Password=bitte-aendern

# Host-Port der Weboberfläche (Standard 8080). Bei Konflikt z. B. auf 8081 setzen.
WEB_HOST_PORT=8080

# URL der vorhandenen Stirling-PDF-Instanz zum Umwandeln von DOCX in PDF.
# Beispiel: http://192.168.178.111:8080 (IP/Port deines laufenden Stirling-PDF-Dienstes).
STIRLING_PDF_BASEURL=http://192.168.178.111:8080

# API-Key für Stirling-PDF, falls dort Authentifizierung aktiviert ist (sonst leer lassen).
# Zu finden in Stirling-PDF unter: Einstellungen -> Account -> API-Key.
STIRLING_PDF_APIKEY=
